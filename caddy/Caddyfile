# Front door for SLATFF.Cloud. Host names come from .env.
# TLS_MODE picks the certificate source: "cloudflare" (default, Let's Encrypt through the
# Cloudflare DNS challenge) or "local" (docs/LOCAL.md, certificate from scripts/local-certs.sh).
(cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
}
(local) {
	tls /certs/tls.crt /certs/tls.key
}

# Identity
{$ID_HOST} {
	import {$TLS_MODE:cloudflare}
	# Requests that arrive through the Cloudflare tunnel carry Cf-Connecting-Ip.
	# The Keycloak admin console, admin API and the master realm (admin sign-in) stay on the
	# local network only.
	@remote_admin {
		header Cf-Connecting-Ip *
		path /admin /admin/* /realms/master /realms/master/*
	}
	# Apple fetches this file (through its CDN) to trust the Platform SSO extension for this
	# host. Create it from caddy/well-known/apple-app-site-association.example.
	handle /.well-known/apple-app-site-association {
		root * /srv/well-known
		rewrite * /apple-app-site-association
		header Content-Type application/json
		file_server
	}
	respond @remote_admin "The admin console is only available on the local network." 403
	reverse_proxy keycloak:8080
}

# AI workspace
{$AI_HOST} {
	import {$TLS_MODE:cloudflare}
	# Model gateway for the IDE bridge (docs/IDE-BRIDGE.md): two paths only.
	@gateway path /gateway/v1/models /gateway/v1/chat/completions
	handle @gateway {
		uri strip_prefix /gateway
		reverse_proxy model-gateway:8080
	}
	reverse_proxy open-webui:8080
}

# Meetings (only answers when the "meet" profile is running)
{$MEET_HOST} {
	import {$TLS_MODE:cloudflare}
	handle /oidc/* {
		reverse_proxy jitsi-adapter:9000
	}
	handle {
		reverse_proxy jitsi-web:80
	}
}

# Files, calendar and contacts (only answers when the "files" profile is running)
{$FILES_HOST} {
	import {$TLS_MODE:cloudflare}
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301
	reverse_proxy nextcloud:80
}
