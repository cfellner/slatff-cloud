# SLATFF.Cloud configuration. Run ./scripts/bootstrap.sh <your-domain> to generate .env
# with your host names and random secrets. Never commit .env.

# --- Host names -------------------------------------------------------------
# Three names under a domain you control, all pointing at this machine's address on
# your own network. See docs/NETWORK.md.
ID_HOST=id.example.org
AI_HOST=ai.example.org
MEET_HOST=meet.example.org
# Optional files service (profile "files"), see docs/FILES.md
FILES_HOST=files.example.org

# --- Certificates -------------------------------------------------------------
# Cloudflare API token limited to "Edit zone DNS" for your domain. You add this yourself.
CLOUDFLARE_API_TOKEN=

# --- Versions (check the current tags before first run) ---------------------
# Platform SSO support needs Keycloak 26.5 or newer.
KEYCLOAK_VERSION=26.8.2
POSTGRES_VERSION=17
OPEN_WEBUI_TAG=main
OLLAMA_TAG=latest
JITSI_TAG=stable-10532-1
NEXTCLOUD_TAG=32-apache
CLOUDFLARED_TAG=latest

# --- Model --------------------------------------------------------------------
# Ollama runs natively on the host by default (a container cannot use a Mac's GPU).
# Only the model gateway talks to it (OpenAI-compatible API under /v1).
MODEL_UPSTREAM_URL=http://host.docker.internal:11434/v1
# true writes prompt text into the gateway's audit log. Off by default (privacy).
GATEWAY_AUDIT_LOG_PROMPTS=false
# Model gateway's Keycloak client secret for token exchange (docs/DELEGATION.md).
# scripts/mac-step5-delegation.sh fills it in if empty.
GATEWAY_CLIENT_SECRET=
# Small model for the AI access test. Check the model's own licence before use.
SLATFF_MODEL=llama3.2:1b

# --- Secrets (bootstrap.sh fills these) ------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
OPEN_WEBUI_CLIENT_SECRET=
WEBUI_SECRET_KEY=
JITSI_CLIENT_SECRET=
JITSI_JWT_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
NEXTCLOUD_CLIENT_SECRET=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Leave empty for the default. Set to declarative-ui when you add the Platform SSO extension
# (docs/PLATFORM-SSO.md). Several features: comma-separated, no spaces.
KC_FEATURES=
# Meetings only: this machine's address on your network, for video traffic.
LAN_IP=
TZ=Europe/London

# Remote access through a Cloudflare tunnel (profile "tunnel"), see docs/REMOTE-ACCESS.md.
# You add this yourself, like the DNS token. Leave empty if you do not use the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Step 8, app-to-app access (docs/APP-TO-APP.md). Filled by scripts/mac-step8-app-to-app.sh.
# KC_FEATURES then contains identity-assertion-jwt (Keycloak's experimental ID-JAG receiver).
NOTES_AGENT_SECRET=
APPS_AGENT_SECRET=
OTHER_APP_SECRET=
